# Copy this file to .streamlit/secrets.toml for local dev (that file is
# git-ignored — never commit it). For the hosted app, paste this same
# content into Streamlit Community Cloud → your app → Settings → Secrets.

[auth]
# Your app's URL + "/oauth2callback". For local dev, leave as-is.
# For the hosted app: "https://YOUR-APP-NAME.streamlit.app/oauth2callback"
redirect_uri = "http://localhost:8501/oauth2callback"

# Any long random string — e.g. generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_RANDOM_STRING"

# From Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application
client_id = "REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret = "REPLACE_WITH_YOUR_CLIENT_SECRET"

server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[access]
# Only these Google accounts will be let past the login screen.
allowed_emails = ["you@gmail.com"]
